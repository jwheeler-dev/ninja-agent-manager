{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "15",
    "BASH_MAX_OUTPUT_LENGTH": "8000"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.cursor/hooks/nam-session-start.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.cursor/hooks/nam-search-hint.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
